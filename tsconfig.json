{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true
  },
  "include": [
    "scripts",
    "tools",
    "reporters",
    "apps/studio-api/src",
    "apps/studio-api/test",
    "packages/*/src",
    "packages/*/test",
    "bricks/credit-wallet/src",
    "bricks/credit-wallet/test",
    "bricks/multi-workspace/src",
    "bricks/multi-workspace/test",
    "bricks/dynamic-entities/src",
    "bricks/dynamic-entities/test",
    "bricks/integration-connections/src",
    "bricks/integration-connections/test",
    "packages/assembler/catalog.generated.ts",
    "test",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "vitest.dom.config.ts",
    "vitest.node.config.ts",
    "vitest.live.config.ts"
  ]
}
