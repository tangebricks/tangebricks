{
  "openapi": "3.0.3",
  "info": {
    "title": "Discord Min",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://discord.com/api/v10"
    }
  ],
  "components": {
    "securitySchemes": {
      "BotToken": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      },
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://discord.com/oauth2/authorize",
            "tokenUrl": "https://discord.com/api/oauth2/token",
            "scopes": {
              "identify": "Identify scope"
            }
          }
        }
      }
    }
  },
  "security": [
    { "BotToken": [] },
    { "OAuth2": ["identify"] }
  ],
  "paths": {
    "/users/@me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
