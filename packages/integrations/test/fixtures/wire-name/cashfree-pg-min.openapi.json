{
  "openapi": "3.0.3",
  "info": {
    "title": "Cashfree PG Min",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.cashfree.com/pg"
    }
  ],
  "paths": {
    "/orders": {
      "post": {
        "operationId": "create_order",
        "summary": "Create Order",
        "parameters": [
          {
            "name": "x-client-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-client-secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-api-version",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter[status]",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "billing-address": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/orders/batch": {
      "post": {
        "operationId": "create-order",
        "summary": "Create Order Colliding",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
