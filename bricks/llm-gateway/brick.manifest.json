{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "llm-gateway",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "llm-router"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_llm_gateway.sql",
    "migrations/0002_billing_status.sql"
  ],
  "routePrefixes": [
    "ai"
  ],
  "npmDependencies": {
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "settings": {
    "defaultProvider": {
      "type": "enum",
      "values": [
        "workers-ai",
        "openai",
        "anthropic",
        "gemini"
      ],
      "default": "workers-ai"
    },
    "models": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^ *[A-Za-z0-9@][A-Za-z0-9@._/:-]{0,63}:[0-9]{1,6}(\\.[0-9]{1,6})?:[0-9]{1,6}(\\.[0-9]{1,6})? *(, *[A-Za-z0-9@][A-Za-z0-9@._/:-]{0,63}:[0-9]{1,6}(\\.[0-9]{1,6})?:[0-9]{1,6}(\\.[0-9]{1,6})? *)*$",
      "example": "gpt-4o-mini:1:2,@cf/meta/llama-3.1-8b-instruct:0.5:1",
      "default": "gpt-4o-mini:1:2"
    },
    "maxTokens": {
      "type": "integer",
      "min": 1,
      "max": 131072,
      "default": 4096
    },
    "billingMode": {
      "type": "enum",
      "values": [
        "wallet",
        "none"
      ],
      "default": "wallet"
    },
    "fallbackProviders": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^( *[A-Za-z0-9_-]{1,30} *(, *[A-Za-z0-9_-]{1,30} *){0,2})?$",
      "example": "openai,anthropic",
      "default": ""
    }
  },
  "ui": {
    "displayName": "LLM Gateway & Prompt Router",
    "category": "ai",
    "summary": "Multi-provider LLM router, prompts, and token usage.",
    "maturity": "beta",
    "maturityReason": "Persists prompt templates and token usage logs in D1; registers no provider adapter by default (generate answers 503 NOT_CONFIGURED); no built-in OpenAI, Anthropic, Gemini or Workers AI adapters",
    "behaviourTest": "test/gateway.test.ts"
  },
  "workspaceData": {
    "tables": [
      {
        "table": "ai_prompt_templates"
      },
      {
        "table": "ai_generation_logs"
      }
    ]
  },
  "worker": {
    "package": "@poc/llm-gateway",
    "routes": [
      {
        "factory": "createAiRoutes",
        "mountAt": "/api",
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/ai",
          "/api/ai/*"
        ],
        "options": {
          "provider": {
            "$setting": "defaultProvider"
          },
          "billing": {
            "$setting": "billingMode"
          },
          "models": {
            "$setting": "models"
          },
          "maxTokens": {
            "$setting": "maxTokens"
          },
          "charger": {
            "$capability": "credit-wallet.walletCharger",
            "requiredWhen": {
              "setting": "billingMode",
              "equals": "wallet"
            }
          },
          "fallbackProviders": {
            "$setting": "fallbackProviders"
          }
        }
      }
    ]
  },
  "privacy": {
    "tables": {
      "ai_prompt_templates": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "ai_generation_logs": {
        "subject": "user",
        "userColumn": "user_id",
        "erase": "delete",
        "export": true
      }
    }
  }
}
