{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "webhook-gateway",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "webhook-gateway"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_webhook_gateway.sql",
    "migrations/0002_webhook_signature_scheme.sql"
  ],
  "routePrefixes": [
    "webhooks"
  ],
  "rateLimits": [
    {
      "method": "POST",
      "path": "/webhooks/in/:subscriptionId",
      "bucket": "webhook-in",
      "limit": 300,
      "windowSeconds": 60,
      "key": "param:subscriptionId"
    },
    {
      "method": "POST",
      "path": "/webhooks/ingress/:slug",
      "bucket": "webhook-ingress",
      "limit": 300,
      "windowSeconds": 60,
      "key": "param:slug"
    }
  ],
  "bindings": [
    "PX_WEBHOOK_ALLOW_UNSIGNED"
  ],
  "secrets": [
    "PX_CONN_KEY"
  ],
  "npmDependencies": {
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "settings": {
    "secretRotationGraceHours": {
      "type": "integer",
      "min": 1,
      "max": 168,
      "default": 24
    }
  },
  "ui": {
    "displayName": "Webhook Ingress & Egress Gateway",
    "category": "automation",
    "summary": "Inbound webhook endpoints, HMAC checks, and rotation.",
    "maturity": "beta",
    "behaviourTest": "test/gateway.test.ts",
    "maturityReason": "CONFORMANCE_KIT_MISSING: Missing shared brick conformance kit suite (UC5.3); promotion to production requires passing conformance kit."
  },
  "nodes": [
    {
      "type": "webhook-gateway.inbound_webhook",
      "label": "Inbound Webhook Trigger",
      "summary": "Triggers when a verified HMAC webhook arrives at the gateway.",
      "role": "trigger",
      "inputs": [],
      "outputs": [
        {
          "id": "out",
          "label": "Webhook Event",
          "dataType": "object"
        }
      ],
      "config": {},
      "executor": "executeInboundWebhookTrigger",
      "durable": true,
      "sideEffects": "none"
    }
  ],
  "workspaceData": {
    "tables": [
      {
        "table": "wh_endpoints"
      },
      {
        "table": "wh_deliveries"
      },
      {
        "table": "wh_subscriptions"
      },
      {
        "table": "px_webhook_deliveries"
      }
    ],
    "exempt": [
      {
        "table": "wh_subscriptions_v2",
        "reason": "Transient migration table; renamed to wh_subscriptions, which is declared"
      },
      {
        "table": "px_connections",
        "reason": "runtime connection vault, project-scoped; scope decided in 1.17"
      }
    ]
  },
  "worker": {
    "package": "@poc/webhook-gateway",
    "routes": [
      {
        "factory": "createWebhookRoutes",
        "mountAt": "/api",
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/webhooks/endpoints",
          "/api/webhooks/endpoints/*",
          "/api/webhooks/subscriptions"
        ],
        "options": {
          "rotationGraceHours": {
            "$setting": "secretRotationGraceHours"
          }
        }
      }
    ]
  },
  "privacy": {
    "hookTables": [
      "wh_subscriptions_v2"
    ],
    "tables": {
      "wh_endpoints": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "wh_deliveries": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "wh_subscriptions": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "px_webhook_deliveries": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "px_connections": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      }
    }
  }
}
