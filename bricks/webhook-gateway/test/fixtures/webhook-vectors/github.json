{
  "preset": "github-hmac-sha256",
  "provenance": {
    "source": "GitHub official docs: Validating webhook deliveries",
    "docUrl": "https://docs.github.com/en/webhooks/using-webhooks/validating-webhook-deliveries",
    "generationCommand": "printf '%s' \"Hello, World!\" | openssl dgst -sha256 -hmac \"It's a Secret to Everybody\""
  },
  "cases": [
    {
      "name": "valid GitHub docs example",
      "preset": "github-hmac-sha256",
      "secret": "It's a Secret to Everybody",
      "headers": {
        "x-hub-signature-256": "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17"
      },
      "rawBody": "Hello, World!",
      "nowSeconds": 1700000000,
      "expect": "ok",
      "provenance": {
        "source": "GitHub documentation 'Validating webhook deliveries'",
        "docUrl": "https://docs.github.com/en/webhooks/using-webhooks/validating-webhook-deliveries",
        "generationCommand": "printf '%s' \"Hello, World!\" | openssl dgst -sha256 -hmac \"It's a Secret to Everybody\""
      }
    },
    {
      "name": "tampered body",
      "preset": "github-hmac-sha256",
      "secret": "It's a Secret to Everybody",
      "headers": {
        "x-hub-signature-256": "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17"
      },
      "rawBody": "Hello, World?!",
      "nowSeconds": 1700000000,
      "expect": "WEBHOOK_SIGNATURE_MISMATCH",
      "provenance": {
        "source": "Negative test vector: tampered body"
      }
    },
    {
      "name": "wrong secret",
      "preset": "github-hmac-sha256",
      "secret": "Not the Secret",
      "headers": {
        "x-hub-signature-256": "sha256=757107ea0eb2509fc211221cce984b8a37570b6d7586c22c46f4379c8b043e17"
      },
      "rawBody": "Hello, World!",
      "nowSeconds": 1700000000,
      "expect": "WEBHOOK_SIGNATURE_MISMATCH",
      "provenance": {
        "source": "Negative test vector: wrong secret"
      }
    }
  ]
}
