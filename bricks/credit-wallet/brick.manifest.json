{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "credit-wallet",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "credit-wallet"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_credit_wallet.sql",
    "migrations/0002_workspace_scoped_idempotency.sql"
  ],
  "routePrefixes": [
    "wallet",
    "payments"
  ],
  "rateLimits": [
    {
      "method": "POST",
      "path": "/wallet/deduct",
      "bucket": "wallet-deduct",
      "limit": 60,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/payments/create-order",
      "bucket": "wallet-create-order",
      "limit": 60,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/payments/verify",
      "bucket": "wallet-verify",
      "limit": 60,
      "windowSeconds": 60,
      "key": "ip"
    }
  ],
  "npmDependencies": {
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "settings": {
    "creditsPerUnit": {
      "type": "integer",
      "min": 1,
      "max": 1000000,
      "default": 1
    },
    "minOrderAmount": {
      "type": "integer",
      "min": 1,
      "max": 1000000000,
      "default": 1
    }
  },
  "ui": {
    "displayName": "Ledger & Credit Wallet",
    "category": "billing",
    "summary": "Atomic double-entry credit ledger, balance invariant engine, and idempotency keys.",
    "maturity": "beta",
    "maturityReason": "NO_DEFAULT_ADAPTER: No payment gateway is configured by default (payment routes answer 503 NOT_CONFIGURED); pending real provider adapter.",
    "behaviourTest": "test/credit-wallet.test.ts"
  },
  "adapters": {
    "paymentGateway": {
      "default": "fake",
      "reason": "No gateway is wired by default (payment routes answer 503 NOT_CONFIGURED); the fake is test-only. Marked fake so the derived tier stays below production until a real adapter exists."
    }
  },
  "nodes": [
    {
      "type": "credit-wallet.debit",
      "label": "Debit Credits",
      "summary": "Atomically debit credits from a tenant wallet with idempotency protection.",
      "role": "action",
      "inputs": [
        {
          "id": "in",
          "label": "Input",
          "dataType": "any",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "out",
          "label": "Ledger Result",
          "dataType": "object"
        }
      ],
      "config": {
        "amount": {
          "type": "integer",
          "min": 1,
          "max": 1000000000,
          "default": 1
        }
      },
      "bindings": [
        "DB"
      ],
      "executor": "executeWalletDebit",
      "durable": true,
      "sideEffects": "write"
    },
    {
      "type": "credit-wallet.credit",
      "label": "Credit Wallet",
      "summary": "Credit a tenant wallet balance and record a ledger entry.",
      "role": "action",
      "inputs": [
        {
          "id": "in",
          "label": "Input",
          "dataType": "any",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "out",
          "label": "Ledger Result",
          "dataType": "object"
        }
      ],
      "config": {
        "amount": {
          "type": "integer",
          "min": 1,
          "max": 1000000000,
          "default": 1
        }
      },
      "executor": "executeWalletCredit",
      "durable": true,
      "sideEffects": "write"
    }
  ],
  "worker": {
    "package": "@poc/credit-wallet",
    "routes": [
      {
        "factory": "createWalletRoutes",
        "mountAt": "/api",
        "options": {
          "creditsPerUnit": {
            "$setting": "creditsPerUnit"
          },
          "minOrderAmount": {
            "$setting": "minOrderAmount"
          }
        },
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/wallet",
          "/api/wallet/*",
          "/api/payments/create-order"
        ]
      }
    ]
  },
  "privacy": {
    "tables": {
      "credit_wallets": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "credit_ledger": {
        "subject": "user",
        "userColumn": "user_id",
        "erase": "delete",
        "export": true
      },
      "credit_orders": {
        "subject": "user",
        "userColumn": "user_id",
        "erase": "delete",
        "export": true
      }
    },
    "hookTables": [
      "credit_ledger_v2"
    ]
  }
}
