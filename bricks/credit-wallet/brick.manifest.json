{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "credit-wallet",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "credit-wallet"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_credit_wallet.sql",
    "migrations/0002_workspace_scoped_idempotency.sql",
    "migrations/0003_order_currency.sql"
  ],
  "routePrefixes": [
    "wallet",
    "payments"
  ],
  "rateLimits": [
    {
      "method": "POST",
      "path": "/wallet/deduct",
      "bucket": "wallet-deduct",
      "limit": 60,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/payments/create-order",
      "bucket": "wallet-create-order",
      "limit": 60,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/payments/verify",
      "bucket": "wallet-verify",
      "limit": 60,
      "windowSeconds": 60,
      "key": "ip"
    },
    {
      "method": "POST",
      "path": "/payments/webhook",
      "bucket": "wallet-webhook",
      "limit": 300,
      "windowSeconds": 60,
      "key": "ip"
    }
  ],
  "npmDependencies": {
    "hono": "4.13.19",
    "zod": "4.6.7"
  },
  "settings": {
    "creditsPerUnit": {
      "type": "integer",
      "min": 1,
      "max": 1000000,
      "default": 1
    },
    "minOrderAmount": {
      "type": "integer",
      "min": 1,
      "max": 1000000000,
      "default": 1
    },
    "paymentCurrency": {
      "type": "string",
      "pattern": "^(|A(OA|[EMU]D|[NW]G|LL|[FZ]N|RS)|B(OB|[BHMNSZ]D|IF|RL|AM|[GTY]N|WP|DT|OV)|C(RC|AD|[HV]E|[DHL]F|ZK|[LOU]P|OU|HW|NY)|D(JF|KK|OP|ZD)|E(GP|RN|TB|UR)|F(JD|KP)|G(BP|EL|HS|IP|MD|NF|TQ|YD)|H(KD|NL|TG|UF)|I(QD|SK|[DNR]R|LS)|J(MD|OD|PY)|K(ES|GS|HR|MF|PW|RW|WD|YD|ZT)|L(AK|BP|KR|RD|SL|YD)|M(GA|[AK]D|[MW]K|DL|[XZ]N|OP|[UVY]R|NT|RU|XV)|N(AD|GN|IO|OK|PR|ZD)|OMR|P(AB|EN|GK|HP|KR|LN|YG)|QAR|R(ON|SD|UB|WF)|S(VC|[BGR]D|LE|DG|EK|ZL|TN|[HSY]P|[AC]R|OS)|T(HB|[NTW]D|OP|[JZ]S|MT|RY)|U(AH|GX|S[DN]|Y[IUW]|ZS)|V(E[DS]|ND|UV)|WST|X(CD|[AOP]F|CG)|YER|Z(AR|MW|WG))$",
      "example": "INR",
      "maxLength": 3,
      "default": ""
    }
  },
  "ui": {
    "displayName": "Ledger & Credit Wallet",
    "category": "billing",
    "summary": "Atomic double-entry credit ledger, balance invariant engine, and idempotency keys.",
    "maturity": "beta",
    "maturityReason": "NO_DEFAULT_ADAPTER: Provider adapters exist (@poc/gateway-adapters) but none is wired by default; payment routes answer 503 NOT_CONFIGURED until a host passes a gateway and a currency.",
    "behaviourTest": "test/credit-wallet.test.ts"
  },
  "adapters": {
    "paymentGateway": {
      "default": "fake",
      "reason": "No gateway is wired by default (payment routes answer 503 NOT_CONFIGURED); the fake is test-only. Marked fake so the derived tier stays below production until a real adapter exists."
    }
  },
  "nodes": [
    {
      "type": "credit-wallet.debit",
      "label": "Debit Credits",
      "summary": "Atomically debit credits from a tenant wallet with idempotency protection.",
      "role": "action",
      "inputs": [
        {
          "id": "in",
          "label": "Input",
          "dataType": "any",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "out",
          "label": "Ledger Result",
          "dataType": "object"
        }
      ],
      "config": {
        "amount": {
          "type": "integer",
          "min": 1,
          "max": 1000000000,
          "default": 1
        }
      },
      "bindings": [
        "DB"
      ],
      "executor": "executeWalletDebit",
      "durable": true,
      "sideEffects": "write"
    },
    {
      "type": "credit-wallet.credit",
      "label": "Credit Wallet",
      "summary": "Credit a tenant wallet balance and record a ledger entry.",
      "role": "action",
      "inputs": [
        {
          "id": "in",
          "label": "Input",
          "dataType": "any",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "out",
          "label": "Ledger Result",
          "dataType": "object"
        }
      ],
      "config": {
        "amount": {
          "type": "integer",
          "min": 1,
          "max": 1000000000,
          "default": 1
        }
      },
      "executor": "executeWalletCredit",
      "durable": true,
      "sideEffects": "write"
    }
  ],
  "workspaceData": {
    "tables": [
      {
        "table": "credit_wallets"
      },
      {
        "table": "credit_ledger",
        "tombstone": true
      },
      {
        "table": "credit_orders",
        "tombstone": true
      }
    ],
    "exempt": [
      {
        "table": "credit_ledger_v2",
        "reason": "Transient migration table; renamed to credit_ledger, which is declared"
      }
    ]
  },
  "worker": {
    "package": "@poc/credit-wallet",
    "capabilityExports": {
      "credit-wallet": [
        "walletCharger"
      ]
    },
    "routes": [
      {
        "factory": "createWalletRoutes",
        "mountAt": "/api",
        "options": {
          "creditsPerUnit": {
            "$setting": "creditsPerUnit"
          },
          "minOrderAmount": {
            "$setting": "minOrderAmount"
          },
          "currency": {
            "$setting": "paymentCurrency"
          }
        },
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/wallet",
          "/api/wallet/*",
          "/api/payments/create-order"
        ]
      }
    ]
  },
  "privacy": {
    "tables": {
      "credit_wallets": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "credit_ledger": {
        "subject": "user",
        "userColumn": "user_id",
        "erase": "delete",
        "export": true
      },
      "credit_orders": {
        "subject": "user",
        "userColumn": "user_id",
        "erase": "delete",
        "export": true
      }
    },
    "hookTables": [
      "credit_ledger_v2"
    ]
  }
}
