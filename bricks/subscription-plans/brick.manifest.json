{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "subscription-plans",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "plan-entitlements"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_subscription_plans.sql",
    "migrations/0002_plan_credits.sql"
  ],
  "routePrefixes": [
    "plans",
    "subscriptions"
  ],
  "npmDependencies": {
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "settings": {
    "defaultTier": {
      "type": "enum",
      "values": [
        "free",
        "pro",
        "enterprise"
      ],
      "default": "free"
    },
    "planCredits": {
      "type": "string",
      "pattern": "^(|[a-z0-9][a-z0-9_.-]{0,63}:[0-9]{1,9}(,[a-z0-9][a-z0-9_.-]{0,63}:[0-9]{1,9}){0,19})$",
      "example": "free:100,pro:1000",
      "maxLength": 512,
      "default": ""
    },
    "creditPeriod": {
      "type": "enum",
      "values": [
        "month",
        "year"
      ],
      "default": "month"
    }
  },
  "ui": {
    "displayName": "Subscription & Plan Entitlements",
    "category": "billing",
    "summary": "Subscription plan catalog, tier changes, and limits.",
    "maturity": "beta",
    "behaviourTest": "test/plans.test.ts",
    "maturityReason": "CONFORMANCE_KIT_MISSING: Missing shared brick conformance kit suite (UC5.3); promotion to production requires passing conformance kit."
  },
  "triggers": {
    "schedules": [
      {
        "id": "plan-credits",
        "cron": "* * * * *",
        "handler": "runPlanCreditSweep",
        "enabledWhen": {
          "setting": "planCredits",
          "notEquals": ""
        },
        "options": {
          "planCredits": {
            "$setting": "planCredits"
          },
          "creditPeriod": {
            "$setting": "creditPeriod"
          },
          "charger": {
            "$capability": "credit-wallet.walletCharger",
            "requiredWhen": {
              "setting": "planCredits",
              "notEquals": ""
            }
          }
        }
      }
    ]
  },
  "conflicts": [
    {
      "brick": "outbound-webhooks",
      "reason": "Both mount routes under the /api/subscriptions prefix"
    }
  ],
  "globalTables": [
    {
      "table": "sub_plans",
      "reason": "Global subscription plan catalog referenced by workspace subscriptions"
    }
  ],
  "workspaceData": {
    "tables": [
      {
        "table": "sub_subscriptions"
      }
    ]
  },
  "worker": {
    "package": "@poc/subscription-plans",
    "routes": [
      {
        "factory": "createPlanRoutes",
        "mountAt": "/api",
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/subscriptions",
          "/api/subscriptions/*"
        ],
        "options": {
          "defaultTier": {
            "$setting": "defaultTier"
          },
          "planCredits": {
            "$setting": "planCredits",
            "requiredWhen": {
              "setting": "planCredits",
              "notEquals": ""
            }
          },
          "creditPeriod": {
            "$setting": "creditPeriod",
            "requiredWhen": {
              "setting": "planCredits",
              "notEquals": ""
            }
          },
          "charger": {
            "$capability": "credit-wallet.walletCharger",
            "requiredWhen": {
              "setting": "planCredits",
              "notEquals": ""
            }
          }
        }
      }
    ]
  },
  "privacy": {
    "tables": {
      "sub_subscriptions": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      }
    }
  }
}
