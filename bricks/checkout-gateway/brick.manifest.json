{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "checkout-gateway",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "checkout-engine"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_checkout_gateway.sql",
    "migrations/0002_verified_payments.sql"
  ],
  "routePrefixes": [
    "checkout"
  ],
  "rateLimits": [
    {
      "method": "POST",
      "path": "/checkout/sessions",
      "bucket": "checkout-create",
      "limit": 30,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/checkout/webhook",
      "bucket": "checkout-webhook",
      "limit": 300,
      "windowSeconds": 60,
      "key": "ip"
    }
  ],
  "npmDependencies": {
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "settings": {
    "paymentCurrency": {
      "type": "string",
      "pattern": "^(|A(OA|[EMU]D|[NW]G|LL|[FZ]N|RS)|B(OB|[BHMNSZ]D|IF|RL|AM|[GTY]N|WP|DT|OV)|C(RC|AD|[HV]E|[DHL]F|ZK|[LOU]P|OU|HW|NY)|D(JF|KK|OP|ZD)|E(GP|RN|TB|UR)|F(JD|KP)|G(BP|EL|HS|IP|MD|NF|TQ|YD)|H(KD|NL|TG|UF)|I(QD|SK|[DNR]R|LS)|J(MD|OD|PY)|K(ES|GS|HR|MF|PW|RW|WD|YD|ZT)|L(AK|BP|KR|RD|SL|YD)|M(GA|[AK]D|[MW]K|DL|[XZ]N|OP|[UVY]R|NT|RU|XV)|N(AD|GN|IO|OK|PR|ZD)|OMR|P(AB|EN|GK|HP|KR|LN|YG)|QAR|R(ON|SD|UB|WF)|S(VC|[BGR]D|LE|DG|EK|ZL|TN|[HSY]P|[AC]R|OS)|T(HB|[NTW]D|OP|[JZ]S|MT|RY)|U(AH|GX|S[DN]|Y[IUW]|ZS)|V(E[DS]|ND|UV)|WST|X(CD|[AOP]F|CG)|YER|Z(AR|MW|WG))$",
      "example": "INR",
      "maxLength": 3,
      "default": ""
    }
  },
  "ui": {
    "displayName": "Multi-Gateway Checkout & Taxes",
    "category": "billing",
    "summary": "Multi-gateway checkout sessions, tax, and invoicing.",
    "maturity": "beta",
    "maturityReason": "Persists checkout sessions, tax calculations, and invoices in D1, but external Stripe, Razorpay, and LemonSqueezy API calls are stubbed with synthetic URLs",
    "behaviourTest": "test/checkout.test.ts"
  },
  "workspaceData": {
    "tables": [
      {
        "table": "pay_checkout_sessions",
        "tombstone": true
      },
      {
        "table": "pay_invoices",
        "tombstone": true
      }
    ]
  },
  "worker": {
    "package": "@poc/checkout-gateway",
    "routes": [
      {
        "factory": "createCheckoutRoutes",
        "mountAt": "/api",
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/checkout",
          "/api/checkout/sessions",
          "/api/checkout/sessions/*",
          "/api/checkout/invoices",
          "/api/checkout/invoices/*"
        ],
        "options": {
          "currency": {
            "$setting": "paymentCurrency"
          }
        }
      }
    ]
  },
  "privacy": {
    "tables": {
      "pay_checkout_sessions": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "pay_invoices": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      }
    }
  }
}
