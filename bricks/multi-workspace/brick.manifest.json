{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "multi-workspace",
  "version": "1.1.0",
  "trust": "first-party",
  "provides": [
    "workspace-context"
  ],
  "requires": [],
  "migrations": [
    "migrations/0001_multi_workspace.sql",
    "migrations/0002_invite_email_expiry.sql"
  ],
  "routePrefixes": [
    "workspaces"
  ],
  "npmDependencies": {
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "settings": {},
  "ui": {
    "displayName": "Multi-Tenant Hierarchy",
    "category": "identity",
    "summary": "Multi-tenant workspace partitioning, membership roles, and tenant isolation middleware.",
    "keywords": ["teams", "tenants", "multitenant", "organizations", "workspaces", "members", "roles"],
    "maturity": "production",
    "behaviourTest": "test/multi-workspace.test.ts"
  },
  "globalTables": [
    {
      "table": "mw_workspaces",
      "reason": "Root workspace tenant table whose primary key id is the workspace identifier"
    }
  ],
  "workspaceData": {
    "tables": [],
    "exempt": [
      {
        "table": "mw_members",
        "reason": "Removed by this brick's own workspace delete route, in the same batch as the purge"
      },
      {
        "table": "mw_invites",
        "reason": "Removed by this brick's own workspace delete route, in the same batch as the purge"
      }
    ]
  },
  "worker": {
    "package": "@poc/multi-workspace",
    "routes": [
      {
        "factory": "createWorkspaceRoutes",
        "mountAt": "/api",
        "options": {
          "workspaceDataPurge": {
            "$workspaceData": "purgeWorkspaceData"
          }
        }
      }
    ],
    "guard": {
      "export": "workspaceMiddleware",
      "capability": "workspace-context",
      "suspension": "requireNotSuspended"
    }
  },
  "privacy": {
    "tables": {
      "mw_members": {
        "subject": "user",
        "userColumn": "user_id",
        "erase": "delete",
        "export": true
      },
      "mw_invites": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      }
    }
  }
}
