{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "metered-usage",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "metering-engine"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_metered_usage.sql",
    "migrations/0002_workspace_scoped_idempotency.sql"
  ],
  "routePrefixes": [
    "meters",
    "events",
    "usage"
  ],
  "npmDependencies": {
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "settings": {},
  "ui": {
    "displayName": "Metered Usage & Event Ingestion",
    "category": "billing",
    "summary": "Usage event counters, windows, and overage tracking.",
    "maturity": "beta",
    "behaviourTest": "test/metering.test.ts",
    "maturityReason": "CONFORMANCE_KIT_MISSING: Missing shared brick conformance kit suite (UC5.3); promotion to production requires passing conformance kit."
  },
  "globalTables": [
    {
      "table": "meter_definitions",
      "reason": "Platform-wide billable meter catalog referenced by workspace usage events"
    }
  ],
  "workspaceData": {
    "tables": [
      {
        "table": "meter_events"
      },
      {
        "table": "meter_aggregates"
      }
    ],
    "exempt": [
      {
        "table": "meter_events_v2",
        "reason": "Transient migration table; renamed to meter_events, which is declared"
      }
    ]
  },
  "worker": {
    "package": "@poc/metered-usage",
    "routes": [
      {
        "factory": "createMeteringRoutes",
        "mountAt": "/api",
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/meters",
          "/api/meters/*",
          "/api/events",
          "/api/events/*",
          "/api/usage",
          "/api/usage/*"
        ]
      }
    ]
  },
  "privacy": {
    "tables": {
      "meter_events": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "meter_aggregates": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      }
    },
    "hookTables": [
      "meter_events_v2"
    ]
  }
}
