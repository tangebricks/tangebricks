{
  "manifestVersion": 2,
  "kind": "brick",
  "id": "omnichannel-outbound",
  "version": "1.0.0",
  "trust": "first-party",
  "provides": [
    "message-dispatcher"
  ],
  "requires": [
    "workspace-context"
  ],
  "migrations": [
    "migrations/0001_omnichannel_outbound.sql",
    "migrations/0002_sender_verification_and_credentials.sql"
  ],
  "routePrefixes": [
    "messages",
    "message-webhooks"
  ],
  "secrets": [
    "PX_CHANNEL_CREDENTIALS_KEY"
  ],
  "rateLimits": [
    {
      "method": "POST",
      "path": "/messages/send",
      "bucket": "messages-send",
      "limit": 60,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/messages/channels",
      "bucket": "messages-channel-create",
      "limit": 5,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/messages/channels/:id/verify",
      "bucket": "messages-verify",
      "limit": 10,
      "windowSeconds": 60,
      "key": "workspace"
    },
    {
      "method": "POST",
      "path": "/message-webhooks/:channelId",
      "bucket": "messages-webhook",
      "limit": 300,
      "windowSeconds": 60,
      "key": "ip"
    },
    {
      "method": "GET",
      "path": "/message-webhooks/:channelId",
      "bucket": "messages-webhook-challenge",
      "limit": 30,
      "windowSeconds": 60,
      "key": "ip"
    }
  ],
  "npmDependencies": {
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "settings": {
    "defaultChannel": {
      "type": "enum",
      "values": [
        "email",
        "sms",
        "whatsapp",
        "slack"
      ],
      "default": "email"
    }
  },
  "ui": {
    "displayName": "Omnichannel Outbound Dispatcher",
    "category": "communication",
    "summary": "Outbound messaging across email, SMS, chat, and Slack.",
    "maturity": "beta",
    "maturityReason": "Verified senders, sealed credentials, dispatch logs and delivery status in D1; no delivery adapter by default (send answers 503 NOT_CONFIGURED); a host wires provider adapters",
    "behaviourTest": "test/dispatcher.test.ts"
  },
  "nodes": [
    {
      "type": "omnichannel-outbound.send_message",
      "label": "Send Outbound Message",
      "summary": "Dispatch an outbound message over email, SMS, WhatsApp, or Slack.",
      "role": "action",
      "inputs": [
        {
          "id": "in",
          "label": "Message",
          "dataType": "any",
          "required": true
        }
      ],
      "outputs": [
        {
          "id": "out",
          "label": "Delivery Receipt",
          "dataType": "object"
        }
      ],
      "config": {
        "channel": {
          "type": "enum",
          "values": [
            "email",
            "sms",
            "whatsapp",
            "slack"
          ],
          "default": "email"
        }
      },
      "executor": "executeSendOutboundMessage",
      "durable": true,
      "sideEffects": "write",
      "secrets": [
        "PX_CHANNEL_CREDENTIALS_KEY"
      ],
      "bindings": [
        "DB"
      ]
    }
  ],
  "workspaceData": {
    "tables": [
      {
        "table": "msg_channels"
      },
      {
        "table": "msg_dispatches"
      }
    ],
    "exempt": [
      {
        "table": "msg_dispatches_v2",
        "reason": "Transient migration table; renamed to msg_dispatches, which is declared"
      }
    ]
  },
  "worker": {
    "package": "@poc/omnichannel-outbound",
    "routes": [
      {
        "factory": "createMessageRoutes",
        "mountAt": "/api",
        "guardWith": "workspace-context",
        "guardPaths": [
          "/api/messages",
          "/api/messages/*"
        ],
        "options": {
          "channel": {
            "$setting": "defaultChannel"
          }
        }
      }
    ]
  },
  "privacy": {
    "tables": {
      "msg_channels": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      },
      "msg_dispatches": {
        "subject": "workspace",
        "erase": "delete",
        "export": true
      }
    },
    "hookTables": [
      "msg_dispatches_v2"
    ]
  }
}
