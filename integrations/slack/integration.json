      "operationId": "chat_postMessage",
      "label": "Sends a message to a channel",
      "summary": "Sends a message to a channel",
      "method": "POST",
      "path": "/chat.postMessage",
      "body": {
        "contentType": "application/x-www-form-urlencoded",
        "fields": [
          {
            "name": "channel",
            "dataType": "string",
            "required": true,
            "description": "Channel ID"
          },
          {
            "name": "text",
            "dataType": "string",
            "description": "Message text"
          },
          {
            "name": "thread_ts",
            "dataType": "string",
            "description": "Thread timestamp"
          }
        ]
      },
      "response": {
        "status": 200,
        "outputs": [
          {
            "id": "channel",
            "dataType": "string"
          },
          {
            "id": "message",
            "dataType": "object"
          },
          {
            "id": "ok",
            "dataType": "boolean"
          },
          {
            "id": "ts",
            "dataType": "string"
          }
        ],
        "errorShape": {
          "codePath": "error"
        }
      },
      "rateLimit": {
        "maxRetries": 3,
        "initialBackoffMs": 200,
        "respectRetryAfter": true,
        "retryAfterHeader": "Retry-After"
      },
      "sideEffects": "write"
    },
