  "triggers": [
    {
      "id": "event_callback",
      "label": "Slack Event Callback",
      "summary": "Fires when a signed Slack Events API payload arrives.",
      "verifier": "slack-v0",
      "signatureHeader": "X-Slack-Signature",
      "eventIdPath": "event_id",
      "eventTypePath": "event.type",
      "outputs": [
        {
          "id": "out",
          "label": "Slack Event",
          "dataType": "object"
        }
      ]
    }
  ],
  "errorWhen": {
    "path": "ok",
    "equals": false
  },
  "errorMappings": {
    "401": {
      "status": 401,
      "code": "CONNECTION_EXPIRED",
      "message": "Slack OAuth token is invalid or revoked.",
      "hint": "Re-authorize the Slack connection in Connections Center.",
      "retryable": false
    },
    "429": {
      "status": 429,
      "code": "RATE_LIMITED",
      "message": "Slack Web API rate limit exceeded.",
      "hint": "Respect Retry-After header before retrying.",
      "retryable": true,
      "retryAfterHeader": "Retry-After"
    }
  },
  "fidelity": {
    "specHash": "sha256:d3da2c0b8ba608d025f96cb63d737f0aae1a640f6efaf51d346e15528e21e0f5",
    "importerVersion": "2.0.0",
    "level": "partial",
