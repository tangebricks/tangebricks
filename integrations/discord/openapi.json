    "/channels/{channelId}/messages": {
      "post": {
        "operationId": "createMessage",
        "summary": "Send channel message",
        "parameters": [
          {
            "name": "channelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "description": "Message text"
                  },
                  "embeds": {
                    "type": "array",
                    "description": "Rich embeds"
                  },
                  "tts": {
                    "type": "boolean",
                    "description": "Text to speech"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "number"
                    },
                    "content": {
                      "type": "string"
                    },
                    "mentions": {
                      "type": "array",
                      "items": {}
                    },
                    "mention_roles": {
                      "type": "array",
                      "items": {}
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
