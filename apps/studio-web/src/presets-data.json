    "entities": [
      {
        "name": "projects",
        "fields": [
          {
            "name": "title",
            "type": "text",
            "required": true
          },
          {
            "name": "status",
            "type": "enum",
            "values": [
              "active",
              "archived"
            ]
          }
        ]
      }
    ],
    "secretRefs": [
      {
        "ref": "sec_better_auth",
        "targetKind": "brick",
        "targetId": "core-auth",
        "secretName": "BETTER_AUTH_SECRET"
      },
      {
        "ref": "sec_github_id",
        "targetKind": "brick",
